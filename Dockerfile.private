FROM node:22-alpine AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html ./
COPY src ./src
COPY public ./public
ENV NODE_OPTIONS=--max-old-space-size=256
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY requirements.private.txt ./
RUN pip install --no-cache-dir -r requirements.private.txt
COPY server/private_server.py ./server/private_server.py
COPY --from=frontend /app/dist ./dist
RUN mkdir -p /data/tutor && chown 10001:10001 /data/tutor && chmod 700 /data/tutor
USER 10001:10001
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
CMD ["uvicorn", "server.private_server:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log", "--ws-max-size", "65536"]
